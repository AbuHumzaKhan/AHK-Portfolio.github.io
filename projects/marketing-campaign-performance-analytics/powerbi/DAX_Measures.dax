Total Spend USD = SUM ( CampaignDaily[spend_usd] )
Attributed Value USD = SUM ( CampaignDaily[revenue_usd] )
Impressions = SUM ( CampaignDaily[impressions] )
Clicks = SUM ( CampaignDaily[clicks] )
Conversions = SUM ( CampaignDaily[conversions] )
CTR = DIVIDE ( [Clicks], [Impressions] )
CPC USD = DIVIDE ( [Total Spend USD], [Clicks] )
Conversion Rate = DIVIDE ( [Conversions], [Clicks] )
CPA USD = DIVIDE ( [Total Spend USD], [Conversions] )
ROAS = DIVIDE ( [Attributed Value USD], [Total Spend USD] )
Planned Budget USD = SUM ( CampaignDaily[daily_budget_usd] )
Budget Utilization = DIVIDE ( [Total Spend USD], [Planned Budget USD] )
Campaign Days = COUNTROWS ( CampaignDaily )