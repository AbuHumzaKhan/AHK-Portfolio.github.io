Total Requests = COUNTROWS('AI Requests')
Completed Requests = CALCULATE([Total Requests], 'AI Requests'[request_status] = "completed")
Accepted Outputs = CALCULATE([Total Requests], 'AI Requests'[final_outcome] = "accepted")
Edited Outputs = CALCULATE([Total Requests], 'AI Requests'[final_outcome] = "edited")
Rejected Outputs = CALCULATE([Total Requests], 'AI Requests'[final_outcome] = "rejected")
Failed Requests = CALCULATE([Total Requests], 'AI Requests'[final_outcome] = "failed")
Successful Outputs = SUM('AI Requests'[successful_output])
Successful Output Rate = DIVIDE([Successful Outputs], [Total Requests])
Acceptance Rate (Completed) = DIVIDE([Accepted Outputs], [Completed Requests])
Edit Rate (Completed) = DIVIDE([Edited Outputs], [Completed Requests])
Rejection Rate (Completed) = DIVIDE([Rejected Outputs], [Completed Requests])
Failure Rate = DIVIDE([Failed Requests], [Total Requests])
Total Cost USD = SUM('AI Requests'[total_cost_usd])
Cost per Successful Output USD = DIVIDE([Total Cost USD], [Successful Outputs])
Average Cost per Request USD = DIVIDE([Total Cost USD], [Total Requests])
Total Tokens = SUM('AI Requests'[total_tokens])
Average Total Latency (ms) = AVERAGE('AI Requests'[total_latency_ms])
P95 Total Latency (ms) = PERCENTILEX.INC('AI Requests', 'AI Requests'[total_latency_ms], 0.95)
Requests With Regeneration = CALCULATE(DISTINCTCOUNT('Interaction Events'[request_id]), 'Interaction Events'[event_type] = "regenerated")
Regeneration Rate = DIVIDE([Requests With Regeneration], [Total Requests])
Average Edit Size (Edited Only) = CALCULATE(AVERAGE('AI Requests'[edit_size_pct]), 'AI Requests'[final_outcome] = "edited")
Regeneration Attempt Cost USD = CALCULATE(SUM('Interaction Events'[event_cost_usd]), 'Interaction Events'[event_type] = "regenerated")
Regeneration Attempt Cost Share = DIVIDE([Regeneration Attempt Cost USD], [Total Cost USD])
